<SelectableResultButton>:
    size_hint_y: None
    height: dp(48)
    text_size: self.width - dp(24), None
    halign: 'left'
    valign: 'middle'
    on_release: app.root.select_result(self.result_index)

<MusicSearchLayout>:
    orientation: 'vertical'
    padding: dp(12)
    spacing: dp(12)

    BoxLayout:
        size_hint_y: None
        height: dp(48)
        spacing: dp(8)

        TextInput:
            id: search_input
            text: root.search_query
            hint_text: 'Search song or artist'
            multiline: False
            on_text: root.search_query = self.text
            on_text_validate: root.on_search_button()

        Button:
            text: 'Search'
            size_hint_x: None
            width: dp(110)
            on_release: root.on_search_button()

    RecycleView:
        id: results_rv
        viewclass: 'SelectableResultButton'
        data: root.rv_data

        RecycleBoxLayout:
            default_size: None, dp(48)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'

    Label:
        text: root.status_text
        size_hint_y: None
        height: dp(28)
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None

    BoxLayout:
        size_hint_y: None
        height: dp(48)
        spacing: dp(8)

        Button:
            text: 'Play Selected'
            on_release: root.play_selected()

        Button:
            text: 'Pause'
            on_release: root.pause_audio()

        Button:
            text: 'Stop'
            on_release: root.stop_audio()
